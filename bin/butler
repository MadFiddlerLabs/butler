#!/bin/bash
# The `butler` command: each course lesson is one line that calls it. `butler setup` is the guided
# first run (plain bash, so it works before Python is installed); everything else runs in Python.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do src="$(readlink "$src")"; done
home="$(cd "$(dirname "$src")/.." && pwd)"

if [ "${1:-}" = "setup" ]; then
  shift
  exec "$home/scripts/first-run.sh" "$@"
fi
if [ ! -x "$home/.venv/bin/python" ]; then
  # `butler` on its own is the way back: before Python exists, that means the first run.
  if [ $# -eq 0 ] && [ -t 0 ]; then
    echo "Your butler's first run isn't finished yet."
    printf 'Pick up where you left off now? Press Enter for yes, or type no: '
    read -r answer || answer=no
    case "$answer" in
      n|N|no|No|NO) echo "When you're ready, type: butler setup"; exit 0 ;;
    esac
    exec "$home/scripts/first-run.sh"
  fi
  echo "Butler is still getting ready. Type: butler setup"
  exit 1
fi
PYTHONPATH="$home/src" exec "$home/.venv/bin/python" -m butler.cli "$@"
