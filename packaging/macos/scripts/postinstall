#!/bin/bash
# Runs right after the package puts Butler in ~/Butler and the Butler app in ~/Applications.
#
#   The Butler app: moved to /Applications when the student's account is an admin (no password
#   needed: /Applications is the admin group's), or kept in ~/Applications. A command-line
#   upgrade keeps it where it was, and another app called Butler is never touched (place_app in
#   scripts/lib/install.sh).
#
#   A fresh install: names the butler from the package's filename (the website serves it as
#   "<Name>.pkg") and opens the guided first run in Terminal.
#   Over an existing Butler (its first run started or finished): changes nothing of the
#   household's and opens Terminal with a choice: resume where you left off, or start fresh.
#   A command-line install (the overnight updater, `installer` in CI) opens nothing.
#
# Terminal opens in the logged-in user's session (launchctl asuser), since Installer may run this
# script as root or outside that session. Every outcome goes to logs/install.log, so a window that
# didn't open can be explained. It never fails the install.
#   $1: the package's path   $2: where it installed
set -u
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source-path=SCRIPTDIR source=../../../scripts/lib/names.sh
. "$here/names.sh"
# shellcheck source-path=SCRIPTDIR source=../../../scripts/lib/install.sh
. "$here/install.sh"
pkg="${1:-}"
target="${2:-}"
user="$(id -un)"
home="$HOME"
if [ "$(id -u)" = 0 ]; then
  user="$(stat -f %Su /dev/console)"
  # dscl puts a path with a space on a line of its own: "NFSHomeDirectory:\n /Users/sam jones".
  home="$(dscl . -read "/Users/$user" NFSHomeDirectory | sed -e 's/^NFSHomeDirectory://' -e 's/^ *//' | tail -n 1)"
fi
dir="$home/Butler"
if [ -n "$target" ] && [ -d "${target%/}/Butler" ]; then
  dir="${target%/}/Butler"
fi
[ -d "$dir" ] || exit 0
if [ "$(id -u)" = 0 ]; then
  chown -R "$user" "$dir"
  [ -d "$home/Applications/Butler.app" ] && chown -R "$user" "$home/Applications/Butler.app"
fi
command_line=""
if [ -n "${COMMAND_LINE_INSTALL:-}" ] || [ -n "${BUTLER_PKG_NO_OPEN:-}" ]; then
  command_line=1
fi

mkdir -p "$dir/logs"
note() {
  printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(cat "$dir/.butler-version" 2>/dev/null || echo dev)" "$*" \
    >> "$dir/logs/install.log"
}

state="$(install_state "$dir")"
name="$(name_from_pkg "$pkg")"
if [ -n "$name" ] && [ "$state" = fresh ]; then
  printf '%s\n' "$name" > "$dir/.butler-name"
fi
[ "$(id -u)" = 0 ] && chown "$user" "$dir/logs" "$dir/.butler-name" 2>/dev/null
# `butler` in any new Terminal window, so "open Terminal and type butler" works even if no window
# opens. The first run adds the same line, once.
add_to_path "$dir" "$home/.zprofile" && note "added Butler to the PATH in ~/.zprofile"
[ "$(id -u)" = 0 ] && chown "$user" "$home/.zprofile"

# The overnight updater and other command-line installs over a household are upgrades: the app
# stays where it is. Installer.app, or a first install, puts it in /Applications when it may.
upgrade=no
[ -n "$command_line" ] && [ "$state" != fresh ] && upgrade=yes
note "$(place_app "$home" "$user" "$upgrade")"

if [ -n "$command_line" ]; then
  note "installed ($state), from the command line: Terminal not opened"
  [ "$(id -u)" = 0 ] && chown "$user" "$dir/logs/install.log"
  exit 0
fi

file="$dir/scripts/$(install_opens "$state")"
uid="$(id -u "$user")"
if [ "$(id -u)" = 0 ]; then
  how="launchctl asuser $uid sudo -u $user open"
  launchctl asuser "$uid" sudo -u "$user" open -a Terminal "$file"
  code=$?
else
  how="launchctl asuser $uid open"
  launchctl asuser "$uid" open -a Terminal "$file"
  code=$?
  # Plain `open` reaches whoever is at the screen, so it's only a way in for the student when
  # that's them. Run for anyone else (no screen session of their own), it opened Terminal in the
  # other person's session.
  if [ "$code" != 0 ] && [ "$(stat -f %Su /dev/console 2>/dev/null)" = "$user" ]; then
    how="open"
    open -a Terminal "$file"
    code=$?
  elif [ "$code" != 0 ]; then
    how="$how; $user isn't the one at the screen, so not open"
  fi
fi
if [ "$code" = 0 ]; then
  note "installed ($state): opened Terminal with $(basename "$file") ($how)"
else
  note "installed ($state): could not open Terminal with $(basename "$file") ($how, exit $code)"
fi
[ "$(id -u)" = 0 ] && chown "$user" "$dir/logs/install.log"
exit 0
