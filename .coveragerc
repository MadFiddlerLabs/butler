[run]
source_pkgs = butler
branch = true
parallel = true
patch = subprocess, execv
data_file = ${BUTLER_COVERAGE_DIR-.}/.coverage

[paths]
butler =
    src/butler
    */src/butler

[report]
show_missing = false
skip_empty = true
# Windows-only code, tested for real on Windows by tests.yml's windows job.
omit = */butler/system/windows.py
precision = 1
# The total floor; per-module floors are in scripts/check_coverage.py (docs/TESTING.md).
fail_under = 87
